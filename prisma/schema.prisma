// Prisma schema — TipMe-like MVP
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum AlertAssetKind {
  SOUND
  STICKER
}

enum ShopItemType {
  DIGITAL
  COMMISSION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  DELIVERED
}

// A product / commission slot a creator sells on their profile.
model ShopItem {
  id          String       @id @default(cuid())
  creatorId   String
  creator     User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type        ShopItemType
  title       String
  description String?
  price       Decimal      @db.Decimal(10, 2)
  imageUrl    String?
  active      Boolean      @default(true)
  // Soft delete: keep the row (orders reference it) but hide it everywhere.
  isArchived  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  orders ShopOrder[]

  @@index([creatorId, isArchived])
}

// A purchase/commission order. Paid via PromptPay + slip (like Tip).
model ShopOrder {
  id           String      @id @default(cuid())
  itemId       String
  item         ShopItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  creatorId    String
  creator      User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  itemTitle    String // snapshot for history
  buyerName    String
  buyerContact String
  note         String?
  amount       Decimal     @db.Decimal(10, 2)
  slipUrl      String?
  status       OrderStatus @default(PENDING)
  transRef     String?     @unique
  createdAt    DateTime    @default(now())
  confirmedAt  DateTime?
  deliveredAt  DateTime?

  @@index([creatorId, status])
}

// A sound/sticker in a creator's random-alert library (many per creator).
model AlertAsset {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AlertAssetKind
  url       String
  createdAt DateTime       @default(now())

  @@index([userId, kind])
}

// A report / issue / suggestion a creator sends to the platform admin.
model Report {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot for admin context (survives later profile edits).
  username  String
  email     String
  category  String       @default("other")
  message   String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

// Website/platform reviews left by visitors (social proof + feedback).
model Review {
  id        String       @id @default(cuid())
  name      String       @default("")
  rating    Int // 1-5
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  username     String   @unique
  displayName  String
  bio          String?
  avatarUrl    String?
  coverUrl     String?
  // Fundraising goal shown as a progress bar on the profile (optional).
  goalTitle    String?
  goalAmount   Decimal? @db.Decimal(10, 2)
  // Whether the goal-bar OBS overlay is shown on stream (creator can toggle).
  goalOverlayEnabled Boolean @default(true)
  // Goal-bar color (hex); null = follow alertColor, then default brand pink.
  goalColor    String?
  // Social profile links: { instagram, youtube, tiktok, facebook, x, discord, website }
  socialLinks  Json?
  // Accent color (hex) for the public profile page; null = default brand pink.
  profileColor String?
  // SENSITIVE (PDPA): PromptPay id (phone / national id). Never expose to public client.
  promptpayId  String?
  // Secret key for the OBS donation-alert overlay URL.
  overlayKey   String?  @unique
  // Creator-customizable donation-alert assets.
  alertSoundUrl String?
  alertImageUrl String?
  alertVideoUrl String?
  // Hex color (e.g. "#ec4899") for the alert card; null = default brand pink.
  alertColor    String?
  // Alert entrance/exit animation style (see src/lib/alertStyles.ts).
  alertStyle    String  @default("pop")
  // Donations >= this amount (baht) get a bigger celebratory alert + confetti.
  // 0 = disabled.
  bigTipThreshold Int   @default(0)
  // Read the supporter's name + message aloud (TTS) when an alert fires.
  ttsEnabled    Boolean @default(false)
  // When true, incoming tips are confirmed automatically (creator trusts the
  // slip / checks their bank) instead of waiting for manual confirmation.
  autoConfirmTips Boolean @default(false)
  // Subathon timer (OBS overlay): confirmed donations add time to a live
  // countdown. Rate = timerSecondsPerUnit seconds added per timerBahtPerUnit baht.
  timerEnabled        Boolean   @default(false)
  timerBahtPerUnit    Int       @default(10)
  timerSecondsPerUnit Int       @default(60)
  timerInitialSeconds Int       @default(3600)
  // Optional cap on total remaining time (seconds); null = no cap.
  timerMaxSeconds     Int?
  // Countdown target while running; null when paused/stopped.
  timerEndsAt         DateTime?
  // Frozen remaining seconds while paused; null when running or reset/stopped
  // (a reset shows timerInitialSeconds). State is derived:
  //   running = timerEndsAt != null; paused = timerRemaining != null; else stopped.
  timerRemaining      Int?
  // Timer clock color (hex); null = follow alertColor, then default brand pink.
  timerColor          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tips          Tip[]
  resetTokens   PasswordResetToken[]
  reports       Report[]
  alertAssets   AlertAsset[]
  shopItems     ShopItem[]
  shopOrders    ShopOrder[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  // SHA-256 hash of the token (raw token is emailed, never stored).
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tip {
  id              String    @id @default(cuid())
  creatorId       String
  creator         User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  supporterName   String
  message         String?
  amount          Decimal   @db.Decimal(10, 2)
  currency        String    @default("THB")
  slipUrl         String?
  status          TipStatus @default(PENDING)
  isMessagePublic Boolean   @default(true)
  // Bank transaction reference from slip verification — unique to block reuse
  // of the same slip. NULL when not verified (Postgres allows many NULLs).
  transRef        String?   @unique
  autoVerified    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  confirmedAt     DateTime?

  @@index([creatorId, status])
}
