// Prisma schema — TipMe-like MVP
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TimerEffect {
  ADD
  REDUCE
  NONE
}

// How a supporter paid. PROMPTPAY = the Thai QR (default, every old tip);
// PAYPAL = the creator's PayPal.me, for supporters abroad.
enum PaymentMethod {
  PROMPTPAY
  PAYPAL
}

enum TipStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  OPEN
  RESOLVED
}

enum AlertAssetKind {
  SOUND
  STICKER
  // Library video: plays instead of image and sound (normal alerts when
  // in the active set, or where a tier picks it).
  VIDEO
}

enum ComboStatus {
  ACTIVE
  ENDED
  // Card turned off mid-combo: ends at once, no summary.
  STOPPED
}

enum SpinStatus {
  ACTIVE
  CANCELLED
}

enum ShopItemType {
  DIGITAL
  COMMISSION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  REJECTED
  DELIVERED
}

// A product / commission slot a creator sells on their profile.
model ShopItem {
  id              String       @id @default(cuid())
  creatorId       String
  creator         User         @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  type            ShopItemType
  title           String
  description     String?
  price           Decimal      @db.Decimal(10, 2)
  imageUrl        String?
  // DIGITAL only: link / key / message auto-delivered to the buyer once payment
  // is confirmed (shown on their receipt page). Null = deliver manually.
  deliverableText String?
  active          Boolean      @default(true)
  // Soft delete: keep the row (orders reference it) but hide it everywhere.
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())

  orders ShopOrder[]

  @@index([creatorId, isArchived])
}

// A purchase/commission order. Paid via PromptPay + slip (like Tip).
model ShopOrder {
  id              String      @id @default(cuid())
  itemId          String
  item            ShopItem    @relation(fields: [itemId], references: [id], onDelete: Restrict)
  creatorId       String
  creator         User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  itemTitle       String // snapshot for history
  buyerName       String
  buyerContact    String
  note            String?
  amount          Decimal     @db.Decimal(10, 2)
  // Legacy public URL (orders before 2026-09-30). New slips go to the
  // private bucket under slipKey, served via /api/shop/orders/[id]/slip.
  slipUrl         String?
  slipKey         String?
  slipPurgedAt    DateTime?
  status          OrderStatus @default(PENDING)
  transRef        String?     @unique
  // Snapshot of the item's deliverable at purchase time (survives later item
  // edits/archive). Present = digital auto-delivery; revealed on the receipt
  // page once status is CONFIRMED/DELIVERED.
  deliverableText String?
  // Unguessable token for the buyer's public receipt/unlock page (no login).
  // Nullable-unique like transRef → safe to add to existing rows.
  receiptToken    String?     @unique
  createdAt       DateTime    @default(now())
  confirmedAt     DateTime?
  deliveredAt     DateTime?

  @@index([creatorId, status])
}

// A sound/sticker in a creator's random-alert library (many per creator).
model AlertAsset {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AlertAssetKind
  url       String
  // Shown to fans when they pick a sound (src/lib/alert-sets.ts). Null =
  // "เสียง N" by library order.
  name      String?
  createdAt DateTime       @default(now())
  setItems  AlertSetItem[]
  pickedBy  Tip[]

  @@index([userId, kind])
}

// Sound set ("ชุด", src/lib/alert-sets.ts): a named group of library files.
// The creator's active set drives normal alerts and the sounds fans may pick.
model AlertSet {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  // Bumped on any item change so running overlays pick up the new media.
  updatedAt DateTime       @updatedAt
  items     AlertSetItem[]
  activeFor User[]         @relation("ActiveSet")

  @@index([userId])
}

model AlertSetItem {
  setId       String
  assetId     String
  // Sounds: whether fans may pick it on the donate page.
  fanPickable Boolean    @default(true)
  // Sounds: minimum tip (baht) for it to play at all, picked or random. 0 = free.
  minAmount   Int        @default(0)
  set         AlertSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  asset       AlertAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([setId, assetId])
  // Library deletes look items up by file (cascade + bumping the sets).
  @@index([assetId])
}

// Goal "หลายชิ้น" (src/lib/wishlist.ts): items fans can choose to help. A
// deleted item is soft-deleted so a full item's baht stays out of the others.
model WishItem {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  price     Int
  imageUrl  String?
  position  Int
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  allocs    WishAlloc[]

  @@index([userId, deletedAt])
}

// Where a tip's baht landed (stored at confirmation; money stays put). Rows
// move only on: deleting an unfilled item, lowering a price, a reject (rows of
// that tip are removed). createdAt decides the goal round it counts in.
model WishAlloc {
  id        String   @id @default(cuid())
  tipId     String
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  itemId    String
  item      WishItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([tipId])
}

enum MediaStatus {
  // Tip not confirmed yet.
  HELD
  // Waiting for the creator's approval.
  PENDING
  APPROVED
  PLAYING
  PLAYED
  SKIPPED
  // Creator removed it before it played.
  REMOVED
  // Tip rejected (startedAt kept: a re-confirm then counts it as played).
  CANCELLED
}

// A fan's clip request ("ขอคลิป/เพลง"): one per tip. Test rows ("ทดสอบบนจอ")
// have no tip. Only the YouTube ID, title and start are kept — never the URL.
model MediaRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipId         String?     @unique
  tip           Tip?        @relation(fields: [tipId], references: [id], onDelete: Cascade)
  kind          String      @default("clip")
  // A clip's YouTube ID; null for a voice message.
  videoId       String?
  title         String
  // Voice message: private object key (cleared when the file is purged).
  audioKey      String?
  durationSec   Int?
  audioPurgedAt DateTime?
  startSec      Int         @default(0)
  status        MediaStatus @default(HELD)
  // Queue order (lower plays first).
  position      Int         @default(0)
  queuedAt      DateTime?
  // Handed to the overlay; startedAt = the video actually began.
  promotedAt    DateTime?
  startedAt     DateTime?
  // Time paused behind popups on the main link (doesn't count toward the limit).
  pausedMs      Int         @default(0)
  pausedAt      DateTime?
  endedAt       DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId, status, position])
  @@index([kind, audioPurgedAt])
}

// Combo tip ("คอมโบทิป", src/lib/combo.ts): a run of confirmed tips. Bar sizes
// and rewards are copied at start (index 0 = level 1); progress = baht in the
// current level. Levels never go down.
model Combo {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         ComboStatus   @default(ACTIVE)
  startedAt      DateTime
  lastTipAt      DateTime
  endedAt        DateTime?
  level          Int           @default(1)
  progress       Int           @default(0)
  total          Int           @default(0)
  sizes          Int[]
  rewards        String[]
  tips           ComboTip[]
  rewardsReached ComboReward[]

  @@index([userId, status])
}

// A tip counted in a combo; levelAfter drives the alert ribbon. counted=false
// once the tip is rejected.
model ComboTip {
  tipId      String  @id
  tip        Tip     @relation(fields: [tipId], references: [id], onDelete: Cascade)
  comboId    String
  combo      Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  amount     Int
  levelAfter Int
  counted    Boolean @default(true)

  @@index([comboId])
}

// A reward reached (text copied then), shown in the to-do list.
model ComboReward {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comboId   String
  combo     Combo     @relation(fields: [comboId], references: [id], onDelete: Cascade)
  level     Int
  text      String
  reachedAt DateTime
  doneAt    DateTime?

  @@unique([comboId, level])
  @@index([userId, doneAt])
}

// Spin wheel ("วงล้อสุ่ม", src/lib/wheel.ts). Every task gets `slots` segments;
// `removed` holds segment keys ("<taskId>#<copy>") taken out when hit.
model Wheel {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  price         Int            @default(50)
  slots         Int            @default(1)
  removeWhenHit Boolean        @default(false)
  removed       String[]       @default([])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  tasks         WheelTaskRow[]
  spins         Spin[]
  activeFor     User[]         @relation("ActiveWheel")

  @@index([userId])
}

model WheelTaskRow {
  id       String  @id @default(cuid())
  wheelId  String
  wheel    Wheel   @relation(fields: [wheelId], references: [id], onDelete: Cascade)
  text     String
  // "ไม่ต้องทำอะไร": a result that skips the to-do list.
  noAction Boolean @default(false)
  position Int

  @@index([wheelId])
}

// One spin per tip, drawn by the server when the tip is confirmed. taskText is a
// snapshot so later edits don't rewrite results. CANCELLED = the tip was
// rejected; confirming again restores it (no re-roll).
model Spin {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipId       String     @unique
  tip         Tip        @relation(fields: [tipId], references: [id], onDelete: Cascade)
  wheelId     String?
  wheel       Wheel?     @relation(fields: [wheelId], references: [id], onDelete: SetNull)
  segmentKey  String
  taskText    String
  noAction    Boolean
  status      SpinStatus @default(ACTIVE)
  confirmedAt DateTime
  // First wheel overlay to fetch it claims it (plays once across sources).
  playedAt    DateTime?
  // Ticked "ทำแล้ว" in the to-do list.
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, status])
}

// Alert tier by amount (src/lib/alert-tiers.ts): tips >= minAmount use these
// overrides; null fields fall back to the normal alert. URLs are library assets.
model AlertTier {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  minAmount   Int
  soundUrl    String?
  imageUrl    String?
  videoUrl    String?
  durationSec Int?
  // Big celebration: larger card + confetti + SUPER TIP badge.
  celebrate   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([userId, minAmount])
}

// A report / issue / suggestion a creator sends to the platform admin.
model Report {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Snapshot for admin context (survives later profile edits).
  username  String
  email     String
  category  String       @default("other")
  message   String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

// Website/platform reviews left by visitors (social proof + feedback).
model Review {
  id        String       @id @default(cuid())
  name      String       @default("")
  rating    Int // 1-5
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  // Null for accounts created via OAuth (Google) — they sign in without a password.
  passwordHash              String?
  // Linked Google account id (the OAuth "sub"). Set when the user signs in with
  // Google; drives the "Google connected" status on the settings page.
  googleId                  String?   @unique
  // When the owner proved they control `email` (verification link, password
  // reset link, or Google sign-in). Null = a password account nobody has
  // proven yet: if Google later signs in with this email, the password is
  // dropped, because whoever set it may not own the address.
  emailVerifiedAt           DateTime?
  // Bumped to sign out every device (password reset, "sign out everywhere").
  // Session tokens carry the version they were issued with.
  sessionVersion            Int       @default(0)
  username                  String    @unique
  displayName               String
  bio                       String?
  avatarUrl                 String?
  coverUrl                  String?
  // Fundraising goal shown as a progress bar on the profile (optional).
  goalTitle                 String?
  goalAmount                Decimal?  @db.Decimal(10, 2)
  // Whether the goal-bar OBS overlay is shown on stream (creator can toggle).
  goalOverlayEnabled        Boolean   @default(true)
  // When the current goal round started ("start a new round" button). Only
  // tips confirmed at/after this moment count toward the goal. Null = never
  // reset, so every confirmed tip counts — the behaviour before this field
  // existed, which keeps existing creators unaffected.
  goalStartedAt             DateTime?
  // Goal-bar color (hex); null = follow alertColor, then default brand pink.
  goalColor                 String?
  // Goal type, bar style and (multi) on-stream display — src/lib/wishlist.ts.
  goalType                  String    @default("single")
  goalStyle                 String    @default("classic")
  goalDisplay               String    @default("all")
  // Social profile links: { instagram, youtube, tiktok, facebook, x, discord, website }
  socialLinks               Json?
  // Accent color (hex) for the public profile page; null = default brand pink.
  profileColor              String?
  // SENSITIVE (PDPA): PromptPay id (phone / national id). Never expose to public client.
  promptpayId               String?
  // PayPal.me name only (no URL), for overseas supporters. Null = PayPal off.
  // Public on purpose: it is rendered as a paypal.me link on the donate page.
  paypalHandle              String?
  // Shown to supporters on the success screen after they tip. Null = none.
  thankYouMessage           String?
  // Secret key for the OBS donation-alert overlay URL.
  overlayKey                String?   @unique
  // Activation tracking (admin-only). Last time the alert overlay polled
  // /api/overlay/[username] with a valid key — written at most once per
  // 5 minutes. Null = never opened (or opened before this column existed).
  overlayLastSeenAt         DateTime?
  // When the one-time "you're stuck here" reminder was emailed. Non-null
  // means never send another one, whatever happens.
  activationNudgeSentAt     DateTime?
  // Old single alert assets. No longer read: the feature-hub media migration
  // moved them into AlertAsset (the library). Kept so old rows stay intact.
  alertSoundUrl             String?
  alertImageUrl             String?
  alertVideoUrl             String?
  // Hex color (e.g. "#ec4899") for the alert card; null = default brand pink.
  alertColor                String?
  // Alert entrance/exit animation style (see src/lib/alertStyles.ts).
  alertStyle                String    @default("pop")
  // Alert card look (src/lib/alertThemes.ts): "light" gradient card or
  // "dark" glow card. Existing creators keep "light".
  alertTheme                String    @default("light")
  // No longer read: the feature-hub migration turned it into an AlertTier
  // with celebrate = true. Kept so old rows stay intact.
  bigTipThreshold           Int       @default(0)
  // Read the supporter's name + message aloud (TTS) when an alert fires.
  ttsEnabled                Boolean   @default(false)
  // Feature hub: alerts can be switched off like goal/timer (default on).
  alertsEnabled             Boolean   @default(true)
  // When the one-time feature-hub chooser was answered/skipped. Null = show it.
  featuresOnboardedAt       DateTime?
  // When true, incoming tips are confirmed automatically (creator trusts the
  // slip / checks their bank) instead of waiting for manual confirmation.
  autoConfirmTips           Boolean   @default(false)
  // Smallest tip the creator accepts (baht). 1 = no restriction.
  minTipAmount              Int       @default(1)
  // Subathon timer (OBS overlay): confirmed donations add time to a live
  // countdown. Rate = timerSecondsPerUnit seconds added per timerBahtPerUnit baht.
  timerEnabled              Boolean   @default(false)
  timerBahtPerUnit          Int       @default(10)
  timerSecondsPerUnit       Int       @default(60)
  timerInitialSeconds       Int       @default(3600)
  // Optional cap on total remaining time (seconds); null = no cap.
  timerMaxSeconds           Int?
  // Countdown target while running; null when paused/stopped.
  timerEndsAt               DateTime?
  // Frozen remaining seconds while paused; null when running or reset/stopped
  // (a reset shows timerInitialSeconds). State is derived:
  //   running = timerEndsAt != null; paused = timerRemaining != null; else stopped.
  timerRemaining            Int?
  // Timer clock color (hex); null = follow alertColor, then default brand pink.
  timerColor                String?
  // Subathon "sabotage": viewers may pay to REDUCE the timer on the creator's
  // terms. Reduce rate is separate from (and by default pricier than) the add
  // rate; reduces can never push the clock below timerFloorSeconds.
  timerReduceEnabled        Boolean   @default(false)
  timerReduceBahtPerUnit    Int       @default(20)
  timerReduceSecondsPerUnit Int       @default(60)
  timerReduceMinAmount      Int       @default(20)
  // Show the tip rates (+time / -time) under the on-stream clock.
  timerShowRates            Boolean   @default(true)
  timerFloorSeconds         Int       @default(300)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  tips                 Tip[]
  resetTokens          PasswordResetToken[]
  verifyTokens         EmailVerificationToken[]
  reports              Report[]
  alertAssets          AlertAsset[]
  alertTiers           AlertTier[]
  alertSets            AlertSet[]
  // The set in use now (always one; see src/lib/alert-sets-server.ts).
  activeSetId          String?                  @unique
  activeSet            AlertSet?                @relation("ActiveSet", fields: [activeSetId], references: [id], onDelete: SetNull)
  // Feature hub card "แฟนเลือกเสียง": show the sound picker on the donate page.
  soundPickEnabled     Boolean                  @default(false)
  wheels               Wheel[]
  spins                Spin[]
  // The wheel in use on the donate page (one at a time).
  activeWheelId        String?                  @unique
  activeWheel          Wheel?                   @relation("ActiveWheel", fields: [activeWheelId], references: [id], onDelete: SetNull)
  // Feature hub card "วงล้อสุ่ม".
  wheelEnabled         Boolean                  @default(false)
  // When the creator ticked the first-enable rules checklist.
  wheelRulesAcceptedAt DateTime?
  // Feature hub card "คอมโบทิป" (src/lib/combo.ts).
  comboEnabled         Boolean                  @default(false)
  // "easy" | "medium" | "hard" | "custom"
  comboDifficulty      String                   @default("medium")
  // LevelRow[]; null = DEFAULT_ROWS.
  comboRows            Json?
  // Combo overlay colour; null = alertColor, then brand pink.
  comboColor           String?
  // Last poll of the combo OBS link: tips only count while it's open.
  comboOverlaySeenAt   DateTime?
  comboCooldownUntil   DateTime?
  combos               Combo[]
  comboRewards         ComboReward[]
  wishItems            WishItem[]
  // Feature hub card "ขอคลิป/เพลง" (src/lib/media.ts, src/lib/media-queue.ts).
  mediaEnabled         Boolean                  @default(false)
  mediaMinAmount       Int                      @default(50)
  mediaMaxSec          Int                      @default(180)
  mediaAutoApprove     Boolean                  @default(false)
  // When the creator confirmed the auto-approve copyright warning.
  mediaAutoAckAt       DateTime?
  mediaVolume          Int                      @default(70)
  // Queue on hold: the clip playing finishes, nothing new starts.
  mediaPaused          Boolean                  @default(false)
  // Last poll of the media OBS link ("เชื่อมต่อแล้ว" badge).
  mediaSeenAt          DateTime?
  // Media card colour; null = alertColor, then brand pink.
  mediaColor           String?
  mediaRequests        MediaRequest[]
  // Feature hub card "ฝากเสียง" (same queue and OBS link as clips).
  voiceEnabled         Boolean                  @default(false)
  voiceMinAmount       Int                      @default(30)
  voiceAutoApprove     Boolean                  @default(false)
  // When the creator confirmed the voice auto-approve warning.
  voiceAutoAckAt       DateTime?
  // Feature hub card "กาชา" (src/lib/gacha.ts): odds per rarity sum to 100;
  // gachaVersion goes up on every odds/prize change (the fan's view is checked).
  gachaEnabled         Boolean                  @default(false)
  gachaPrice           Int                      @default(50)
  gachaCommon          Int                      @default(70)
  gachaRare            Int                      @default(25)
  gachaEpic            Int                      @default(5)
  gachaVersion         Int                      @default(0)
  gachaColor           String?
  // The gacha's own rules checklist (not the wheel's: its odds aren't equal).
  gachaRulesAcceptedAt DateTime?
  gachaPrizes          GachaPrize[]
  gachaPulls           GachaPull[]
  // Feature hub card "PK" (src/lib/pk.ts): matches are started from its page.
  pkEnabled            Boolean                  @default(false)
  // Creator vs creator: refuse invitations from other creators.
  pkInvitesOff         Boolean                  @default(false)
  pkOwned              PkMatch[]                @relation("PkOwner")
  pkOpposed            PkMatch[]                @relation("PkOpponent")
  // Feature hub card "ตีบอส" (src/lib/boss.ts). A run goes up on reset;
  // bossLife = bosses defeated in this run; bossDefId = the current boss.
  bossEnabled          Boolean                  @default(false)
  bossRun              Int                      @default(0)
  bossLife             Int                      @default(0)
  bossDamage           Int                      @default(0)
  bossDefId            String?
  // Last poll of the boss OBS link: damage only counts while it's open.
  bossSeenAt           DateTime?
  bossColor            String?
  // Two OBS links (src/lib/obs-stage.ts): last poll of the main and bars links,
  // and of the per-feature popup links (a live one keeps its feature, C4).
  mainSeenAt           DateTime?
  barsSeenAt           DateTime?
  wheelSeenAt          DateTime?
  gachaSeenAt          DateTime?
  bossLinkSeenAt       DateTime?
  bossDefs             BossDef[]
  bossHits             BossHit[]
  bossKills            BossKill[]
  shopItems            ShopItem[]
  shopOrders           ShopOrder[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  // SHA-256 hash of the token (raw token is emailed, never stored).
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Email ownership proof for password sign-ups (24h, single use).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  // SHA-256 hash of the token (raw token is emailed, never stored).
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Tip {
  id              String        @id @default(cuid())
  bossHits        BossHit[]
  creatorId       String
  creator         User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  supporterName   String
  message         String?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("THB")
  slipUrl         String?
  // Storage object key in the PRIVATE slip bucket; served only through
  // /api/tips/[id]/slip. slipUrl is the legacy public URL until migrated.
  slipKey         String?
  // Set when the slip image was deleted by the retention job (the tip row and
  // its transRef stay, so duplicate-slip checks keep working).
  slipPurgedAt    DateTime?
  // What this tip does to the subathon clock. ADD is the historical default
  // (every confirmed tip added time); NONE = supporter chose "just donate".
  timerEffect     TimerEffect   @default(ADD)
  paymentMethod   PaymentMethod @default(PROMPTPAY)
  // The sound the fan picked (and paid at least its minimum for). Null = none,
  // or the file was deleted since — the alert then falls back to tier/set.
  pickedSoundId   String?
  pickedSound     AlertAsset?   @relation(fields: [pickedSoundId], references: [id], onDelete: SetNull)
  // The wheel the fan saw when asking to spin. No FK: a deleted wheel keeps the
  // id so the confirm button can warn.
  spinWheelId     String?
  spin            Spin?
  // Confirmed while the combo link was open and the card on (counts for combos).
  comboEligible   Boolean       @default(false)
  comboTip        ComboTip?
  // Goal item the fan chose (no FK: the item may be deleted later).
  wishItemId      String?
  wishAllocs      WishAlloc[]
  mediaRequest    MediaRequest?
  // "กาชา": the fan asked for a pull, and the box they saw (odds + prizes).
  gachaPull       Boolean       @default(false)
  gachaBox        Json?
  gachaResult     GachaPull?
  // "PK": the match and side ("A" | "B") the fan chose (no FK; validated on create).
  pkMatchId       String?
  pkSide          String?
  status          TipStatus     @default(PENDING)
  isMessagePublic Boolean       @default(true)
  // Bank transaction reference from slip verification — unique to block reuse
  // of the same slip. NULL when not verified (Postgres allows many NULLs).
  transRef        String?       @unique
  autoVerified    Boolean       @default(false)
  // Slip screening verdict from the verifier (Gemini/SlipOK/EasySlip), shown as
  // a flag on the dashboard to help manual review. NULL = not screened.
  //   verifyCode:   "match" | "amount" | "receiver" | "notslip" | "unreadable"
  //   verifyDetail: short extra context (e.g. the amount the slip actually shows)
  verifyCode      String?
  verifyDetail    String?
  createdAt       DateTime      @default(now())
  confirmedAt     DateTime?

  @@index([creatorId, status])
  // Library deletes null this out (ON DELETE SET NULL); avoid a full scan.
  @@index([pickedSoundId])
  @@index([spinWheelId])
  @@index([creatorId, comboEligible, confirmedAt])
  @@index([wishItemId])
  @@index([pkMatchId, status])
  @@index([creatorId, status, createdAt])
}

// "กาชา" prize: rarity "common" | "rare" | "epic". Soft-deleted so past pulls
// keep their snapshot.
model GachaPrize {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rarity    String
  text      String
  imageUrl  String?
  noAction  Boolean   @default(false)
  position  Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A gacha result for one tip (drawn at confirm from the tip's box). The prize
// is a snapshot; reject cancels it, confirming again restores the same one.
model GachaPull {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipId       String     @unique
  tip         Tip        @relation(fields: [tipId], references: [id], onDelete: Cascade)
  rarity      String
  prizeId     String?
  prizeText   String
  imageUrl    String?
  noAction    Boolean    @default(false)
  status      SpinStatus @default(ACTIVE)
  confirmedAt DateTime
  // First gacha overlay to fetch it claims it (plays once across sources).
  playedAt    DateTime?
  // Ticked "ทำแล้ว" in the to-do list.
  doneAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([userId, status])
}

enum PkStatus {
  // Creator vs creator invitation waiting for an answer.
  PENDING
  ACTIVE
  ENDED
  CANCELLED
  DECLINED
}

// A PK match (spec docs/superpowers/specs/2026-10-24-pk-design.md): "solo" =
// two sides in one stream (fans pick a side), "duo" = creator vs creator.
// Names are snapshots so history survives account deletion (users SetNull).
model PkMatch {
  id          String    @id @default(cuid())
  kind        String
  ownerId     String?
  owner       User?     @relation("PkOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  opponentId  String?
  opponent    User?     @relation("PkOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  status      PkStatus  @default(ACTIVE)
  nameA       String
  nameB       String
  colorA      String
  colorB      String
  durationSec Int
  // Confirms in flight still count this long after the end (60 s auto-confirm, 300 s manual).
  graceSec    Int       @default(60)
  startedAt   DateTime?
  endsAt      DateTime?
  endedAt     DateTime?
  // Frozen result (whole baht).
  totalA      Int?
  totalB      Int?
  // Creator vs creator: the side ("A" owner, "B" opponent) that gave up mid-match; the other wins.
  forfeitBy   String?
  createdAt   DateTime  @default(now())

  @@index([ownerId, status])
  @@index([opponentId, status])
}

// Boss raid ("ตีบอส", spec docs/superpowers/specs/2026-10-24-boss-design.md).
// The creator's list; soft-deleted so a run's pointer can find the next one.
model BossDef {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  hp        Int
  reward    String    @default("")
  imageUrl  String?
  position  Int
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, deletedAt])
}

// Damage one tip dealt to one boss life. counted=false once the tip is
// rejected (hits on the current life are deleted then; earlier ones stay).
model BossHit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipId     String
  tip       Tip      @relation(fields: [tipId], references: [id], onDelete: Cascade)
  run       Int
  life      Int
  amount    Int
  fan       String
  counted   Boolean  @default(true)
  createdAt DateTime

  @@index([userId, run, life])
  @@index([tipId])
}

// A defeated boss (snapshots). The OBS link claims it once (playedAt); a
// reward makes it a to-do item (doneAt).
model BossKill {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  run       Int
  life      Int
  bossName  String
  hp        Int
  reward    String
  imageUrl  String?
  killer    String
  topFan    String
  topAmount Int
  killedAt  DateTime
  playedAt  DateTime?
  doneAt    DateTime?

  @@unique([userId, run, life])
  @@index([userId, playedAt])
  @@index([userId, doneAt])
  @@index([userId, killedAt])
}
