# ===== Database (Supabase Postgres) =====
# Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL = pooled connection (port 6543, ?pgbouncer=true) — used by the app at runtime
# DIRECT_URL   = direct connection (port 5432) — used by prisma migrate
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ===== Auth.js =====
AUTH_SECRET="generate-with: npx auth secret  (or openssl rand -base64 32)"

# ===== Google OAuth (OPTIONAL — "Continue with Google") =====
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorized redirect URI: https://YOUR_DOMAIN/api/auth/callback/google
# The Google button only appears when BOTH are set.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Platform admin email(s) that can moderate reviews (comma-separated)
ADMIN_EMAIL=""

# ===== Email (password reset + tip notifications) — OPTIONAL =====
# Without any of these set, messages are only logged to the server console (dev).
# Resend with the verified tiptang.com domain (unset = emails print to the dev console).
# RESEND_API_KEY=""
# RESEND_FROM="TipTang <support@tiptang.com>"

# Daily slip-retention job (/api/cron/purge-slips). Vercel Cron sends it as a
# Bearer token; without it the route refuses every call.
# CRON_SECRET=""
# Reply-To on every outgoing email (default support@tiptang.com):
# EMAIL_REPLY_TO="support@tiptang.com"

# ===== Rate limiting (OPTIONAL — Upstash Redis) =====
# Without these, an in-memory limiter is used (fine for local/dev, weak on serverless).
# From Upstash console -> your Redis database -> REST API.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ===== Supabase Storage (slip / avatar uploads) =====
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-keep-secret"
SUPABASE_BUCKET="uploads"
# PRIVATE bucket for donation slips — create it in Supabase Storage with "Public bucket" OFF.
# Slips are only ever served through short-lived signed URLs to the tip owner.
SUPABASE_SLIP_BUCKET="slips"

# Storage driver: "supabase" or "local" (defaults to supabase when NEXT_PUBLIC_SUPABASE_URL is set)
# STORAGE_DRIVER="supabase"

# ===== Slip auto-verification (OPTIONAL) =====
# Leave SLIP_VERIFY_PROVIDER empty to keep manual confirmation only.
# When set, slips are auto-checked and auto-confirmed if valid + amount + receiver match.
# SLIP_VERIFY_PROVIDER="easyslip"        # or "slipok" or "gemini"
# Optional free fallback when the primary is out of quota / errors (recommended
# with a real bank-verify primary): real API while quota lasts, then Gemini.
# SLIP_VERIFY_FALLBACK="gemini"          # never overrides a "duplicate" verdict
# EasySlip (https://easyslip.com):
# EASYSLIP_API_TOKEN=""
# SlipOK (https://slipok.com):
# SLIPOK_API_KEY=""
# SLIPOK_BRANCH_ID=""
# Gemini (https://aistudio.google.com/apikey) — reads the slip image (OCR),
# NOT a bank-side check; free tier. Fail-safe (uncertain -> stays PENDING).
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"        # optional, this is the default
#   (note: gemini-2.0-flash has no free-tier quota anymore -> HTTP 429 limit:0)
